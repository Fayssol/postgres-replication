<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Liste des scénarios de tests -->
    <record id="view_postgres_ha_test_list" model="ir.ui.view">
        <field name="name">postgres.ha.test.list</field>
        <field name="model">postgres.ha.test</field>
        <field name="arch" type="xml">
            <list string="Scénarios de tests">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Formulaire d'un scénario -->
    <record id="view_postgres_ha_test_form" model="ir.ui.view">
        
        <field name="name">postgres.ha.test.form</field>
        <field name="model">postgres.ha.test</field>
        <field name="arch" type="xml">
            <form string="Scénario de test">
                <header>
                    <button
                        name="action_run_test"
                        type="object"
                        string="Exécuter"
                        class="oe_highlight"
                        invisible="not active"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Historique des exécutions">
                            <field name="result_ids">
                                <list>
                                    <field name="execution_date"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'success'"
                                           decoration-danger="status in ('failed', 'error')"
                                           decoration-warning="status in ('pending', 'running')"/>
                                    <field name="duration"/>
                                    <field name="leader_before"/>
                                    <field name="leader_after"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action des scénarios -->
    <record id="action_postgres_ha_tests" model="ir.actions.act_window">
        <field name="name">Scénarios de tests</field>
        <field name="res_model">postgres.ha.test</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
