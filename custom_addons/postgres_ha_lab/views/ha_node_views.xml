<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_postgres_ha_node_list" model="ir.ui.view">
        <field name="name">postgres.ha.node.list</field>
        <field name="model">postgres.ha.node</field>
        <field name="arch" type="xml">
            <list string="Nœuds PostgreSQL">
                <field name="name"/>
                <field name="host"/>
                <field name="patroni_api_port"/>
                <field name="role" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'running'"
                       decoration-danger="state == 'stopped'"/>
                <field name="last_check"/>
            </list>
        </field>
    </record>

    <record id="view_postgres_ha_node_form" model="ir.ui.view">
        <field name="name">postgres.ha.node.form</field>
        <field name="model">postgres.ha.node</field>
        <field name="arch" type="xml">
            <form string="Nœud PostgreSQL">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="name"/>
                            <field name="host"/>
                            <field name="patroni_api_port"/>
                        </group>
                        <group string="Supervision">
                            <field name="role"/>
                            <field name="state"/>
                            <field name="last_check"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_postgres_ha_nodes" model="ir.actions.act_window">
        <field name="name">Nœuds PostgreSQL</field>
        <field name="res_model">postgres.ha.node</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
