# .env.example
# Copiez ce fichier en .env et remplissez avec vos valeurs réelles
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
FROM_EMAIL=votre-email@gmail.com
TO_EMAIL=email-destination@domain.com
SMTP_USERNAME=votre-email@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-application
ODOO_DB_PASSWORD=changeYourPassword
#HA_POSTGRES_PASSWORD=postgres
HA_POSTGRES_USER=postgres
HA_POSTGRES_PASSWORD=postgres_password
HA_POSTGRES_DB=postgres
HA_POSTGRES_PORT=5432

# Connexion Pgpool-II depuis Odoo
HA_PGPOOL_HOST=pgpool
HA_PGPOOL_PORT=9999

# API REST Patroni
HA_PATRONI_API_PORT=8008

# Délai maximal d'attente après un switchover
HA_FAILOVER_TIMEOUT_SECONDS=90